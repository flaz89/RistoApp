# Copia questo file in .env.local e riempi i valori veri.
# .env.local è ignorato da git: i segreti restano solo sul tuo computer.

# --- Supabase (dashboard > Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chiave con privilegi totali: SOLO lato server, MAI nel frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- Stripe (dashboard > Developers > API keys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- MapTiler (mappa /ristoranti — dashboard maptiler.com > Account > Keys) ---
# Chiave pubblica per il client (come la publishable di Stripe): finisce nel
# browser, quindi va limitata per dominio nella dashboard MapTiler.
# Senza chiave la mappa mostra uno sfondo neutro; i pin restano posizionati.
NEXT_PUBLIC_MAPTILER_KEY=
